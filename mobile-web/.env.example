# Copy to .env and fill in from Supabase → Project Settings → API (or "API Keys").
# Without these two values the app runs the browser-only demo with sample data.
# The anon / publishable key is public by design (it ships inside the app). Never put the
# service_role / secret key here.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
