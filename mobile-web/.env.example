# Copy to .env.local for local overrides. Never commit real secrets.
# Base path the app is served from (CI sets /seaon-app/ for GitHub Pages).
VITE_BASE=/
# Backend API base URL. Empty = mock mode (local test data, no server).
VITE_API_BASE_URL=
# Web Push VAPID *public* key (the private key stays on the server only).
VITE_VAPID_PUBLIC_KEY=
